# Copie para .env.local e preencha. O .env.local não vai para o Git.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Supabase: Project Settings > API (use a chave "anon"/publishable, nunca a service_role).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Map ID vetorial (Google Cloud > Maps > Map Management): liga o mapa inclinado e girando na corrida. Sem ele o app usa DEMO_MAP_ID, só para teste.
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
