{
  "expo": {
    "name": "Pace",
    "slug": "pace-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paceapp.pace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paceapp.pace"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Pace usa sua localização para mostrar você no mapa e as rotas próximas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Pace usa suas fotos para anexar imagens aos alertas.",
          "cameraPermission": "O Pace usa a câmera para fotografar o que você quer avisar.",
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#0d0d12",
    "extra": {
      "eas": {
        "projectId": "9aa05538-dd9a-4aba-a60d-654fc8571259"
      }
    },
    "owner": "lordetome"
  }
}
